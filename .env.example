# Supabase (Database + Auth + pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://gbohrbupidoklhhryswr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (LLM / synthesis, citation enforcement)
ANTHROPIC_API_KEY=

# Voyage AI (embeddings — used consistently across ingestion and query)
VOYAGE_API_KEY=

# Resend (sends the doctor-verification email OTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server-only secret used to key the OTP hash (HMAC-SHA256) — generate a long random string,
# e.g. `openssl rand -hex 32`. Never commit the real value.
OTP_HMAC_SECRET=

# NCBI E-utilities / PMC (PubMed Tier-2 ingestion — lib/ingestion/pubmed.ts). Free, no signup
# required for NCBI_API_EMAIL alone. NCBI_API_KEY is optional — raises the rate limit from 3
# req/sec to 10/sec, not needed for founder-run one-at-a-time usage.
NCBI_API_EMAIL=
NCBI_API_KEY=
